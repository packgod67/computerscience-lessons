node_modules/
# Anchor with leading / so this only ignores root-level package.json
# (a leftover from old root-package experiments). Subdirectory
# package.json files like netplay-server/package.json need to be
# committed for their respective deploy targets.
/package.json
/package-lock.json
import_games.py
screenshot_games.js
split_games.py
deploy.py
games/games_part*.json
games/filelist_part*.txt
.claude/

# Secrets & credentials — never commit these
.env
.env.*
*.key
*.pem
credentials*.json
serviceAccount*.json
secrets.*

