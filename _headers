# Render / Netlify / Cloudflare Pages _headers syntax.
# These are per-path HTTP response headers layered on top of the static file
# serving. Order matters — more specific paths come first.

# Play! PS2 emulator needs SharedArrayBuffer, which requires cross-origin
# isolation. Setting COOP+COEP on the /play/* subtree only so the rest of
# the arcade (iframes from archive.org etc.) isn't forced into isolation
# and broken.
/play/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: cross-origin
  # Cache the WASM aggressively — it's content-hashed by emscripten so a
  # new build invalidates via a filename change.
  Cache-Control: public, max-age=3600

# The WASM file itself must advertise that it's embeddable under COEP.
/play/Play.wasm
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# Pin the PWA manifest to the spec-correct MIME type. Without this, some
# hosts fall back to application/json or octet-stream, which on Android
# routes the file to the system intent chooser — Google Wallet registers
# for generic JSON content and ends up listed as "Open with…", confusing
# users into thinking the install is broken. Chrome's PWA detection also
# sometimes silently fails to fire beforeinstallprompt when the MIME is
# wrong.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
